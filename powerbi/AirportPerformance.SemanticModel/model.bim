    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "_",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "e248765a-6a6d-4363-9d32-868009e0a375",
            "sourceColumn": "_",
            "summarizeBy": "none"
          }
        ],
        "description": "Holds the measures. Contains no data.",
        "lineageTag": "e242cfd2-2d37-4f11-b72f-0b42600bba8c",
        "measures": [
          {
            "name": "Scheduled Flights",
            "description": "Every flight on the timetable, including cancelled and diverted.",
            "displayFolder": "Flight counts",
            "expression": "COUNTROWS ( fact_flight )",
            "formatString": "#,0",
            "lineageTag": "d9ac7886-1adf-4028-8f90-bad9ef491981"
          },
          {
            "name": "Analytical Flights",
            "description": "Flights that actually flew and have a recorded arrival delay. This is what the KPI divides by.",
            "displayFolder": "Flight counts",
            "expression": "CALCULATE ( COUNTROWS ( fact_flight ), fact_flight[is_analytical] = TRUE )",
            "formatString": "#,0",
            "lineageTag": "4b579389-5329-4d4a-a058-c45215a1eb3d"
          },
          {
            "name": "On Time Flights",
            "description": "Arrived within the threshold. No chart shows it directly, but On Time Pct divides by it.",
            "displayFolder": "Flight counts",
            "expression": "CALCULATE ( COUNTROWS ( fact_flight ), fact_flight[is_on_time] = TRUE )",
            "formatString": "#,0",
            "lineageTag": "0dcb38f2-a970-464f-90b4-f007765a0564"
          },
          {
            "name": "Target On Time Pct",
            "description": "The goal, read from the rule table.",
            "displayFolder": "KPI",
            "expression": "DIVIDE ( SELECTEDVALUE ( dim_kpi_threshold[target_pct], 85 ), 100 )",
            "formatString": "0.00%",
            "lineageTag": "5fa1ae16-a6fb-4bf8-8ef5-f17894df33c1"
          },
          {
            "name": "On Time Pct",
            "description": "The headline: on-time flights divided by flights we can grade.",
            "displayFolder": "KPI",
            "expression": "DIVIDE ( [On Time Flights], [Analytical Flights] )",
            "formatString": "0.00%",
            "lineageTag": "1f68b53f-81fb-4618-8246-21aee0bdfd3e"
          },
          {
            "name": "Gap To Target pp",
            "description": "Percentage points above (+) or below (-) target.",
            "displayFolder": "KPI",
            "expression": "( [On Time Pct] - [Target On Time Pct] ) * 100",
            "formatString": "#,0.00",
            "lineageTag": "9dc91c09-ae9b-4fe6-837c-43df549ae9a6"
          },
          {
            "name": "Compliance Status",
            "description": "Pass or fail against the target.",
            "displayFolder": "KPI",
            "expression": "IF ( ISBLANK ( [On Time Pct] ), \"No data\", IF ( [On Time Pct] >= [Target On Time Pct], \"Compliant\", \"Non-Compliant\" ) )",
            "lineageTag": "414d5d90-4fb2-4b2e-9242-a2d0cccf5840"
          },
          {
            "name": "Avg Delay Minutes",
            "description": "Average minutes late arriving.",
            "displayFolder": "Delay",
            "expression": "CALCULATE ( AVERAGE ( fact_flight[delay_minutes] ), fact_flight[is_analytical] = TRUE )",
            "formatString": "#,0.00",
            "lineageTag": "ffe43ad2-583f-4cdf-bb49-49a7e5b7bf64"
          },
          {
            "name": "Delay Hours",
            "description": "Total hours of delay, grouped by the reason the airline reported.",
            "displayFolder": "Delay",
            "expression": "DIVIDE ( SUM ( fact_delay_reason[minutes] ), 60 )",
            "formatString": "#,0",
            "lineageTag": "d61237a2-d572-4691-905e-0667508abad0"
          }
        ],
        "partitions": [
          {
            "name": "_Measures-partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table({\"_\"}, {{\"\"}})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
      },
